# --- Required ---
# OpenRouter API key (used for all LLM calls). Get one at https://openrouter.ai/keys
NEXT_OPENROUTER_KEY=

# Replicate API token (used for image generation). Get one at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# --- Optional ---
# Port to run the server on (default: 3000 in dev, 8801 in production)
PORT=3000

# Save generated images/graphs to disk (set to "true" for persistent storage)
NEXT_PUBLIC_SAVE_MODE=true

# Enable LLM-powered suggestions (set to "false" to disable)
NEXT_PUBLIC_LLM_ENABLED=true

# Discussion forum integration (optional)
NEXT_PUBLIC_FORUM_API_KEY=
NEXT_PUBLIC_FORUM_USERNAME=
NEXT_PUBLIC_FORUM_POST_URL=
